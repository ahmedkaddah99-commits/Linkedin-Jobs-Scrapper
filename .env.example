# Copy to .env for non-secret local defaults. Keep credentials in dev.env.
RUNR_ENV=development

# Database: local SQLite remains the zero-configuration default.
DATABASE_BACKEND=sqlite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Object storage: local in development, s3/r2 in production.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_ROOT=.backend_storage/objects
OBJECT_STORAGE_CACHE_ROOT=.backend_storage/cache
LOCAL_OBJECT_STORAGE_BASE_URL=http://127.0.0.1:8000/v1/storage/objects
LOCAL_OBJECT_STORAGE_SIGNING_SECRET=replace-with-a-local-development-secret
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
S3_SIGNED_URL_TTL_SECONDS=900

# Authentication and billing credentials should normally be set in dev.env or Render.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRO_PRODUCT_ID=
CREEM_BUSINESS_PRODUCT_ID=

# Frontend build configuration.
VITE_API_BASE_URL=http://127.0.0.1:8000/v1
VITE_CLERK_PUBLISHABLE_KEY=

BACKEND_ALLOWED_ORIGINS=http://127.0.0.1:4173
PORT=8000
RUNR_DISABLE_QUOTAS=true

# Optional: enables live public-web target-contact discovery.
# Leave unset for deterministic local/test behavior.
RUNR_ENABLE_LIVE_NETWORKING_DISCOVERY=
# Optional: enables DeepSeek planning/resolution inside live networking discovery.
# Leave unset/0 to use deterministic public-profile search and heuristic ranking.
RUNR_ENABLE_NETWORKING_DISCOVERY_AI=

# Clerk session token template expected by the frontend/backend integration:
# Name: runr_backend
# Claims:
# {
#   "publicMetadata": {
#     "role": "{{user.public_metadata.role}}",
#     "plan_id": "{{user.public_metadata.plan_id}}",
#     "quota_overrides": "{{user.public_metadata.quota_overrides}}"
#   }
# }
