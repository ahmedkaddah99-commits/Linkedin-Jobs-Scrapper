FROM node:22-bookworm-slim AS node-runtime

FROM python:3.12-slim-bookworm

ARG RUNR_RELEASE_COMMIT=unknown
ARG RUNR_RELEASE_BRANCH=unknown
ARG RUNR_RELEASE_SERVICE=worker

LABEL org.opencontainers.image.title="runr-worker" \
      org.opencontainers.image.description="Runr customer/acquisition worker runtime" \
      org.runr.release.service="${RUNR_RELEASE_SERVICE}" \
      org.runr.release.commit="${RUNR_RELEASE_COMMIT}" \
      org.runr.release.branch="${RUNR_RELEASE_BRANCH}" \
      org.runr.release.contract="runr-contract-v1"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    RUNR_IMAGE_SERVICE=worker \
    RUNR_RELEASE_COMMIT=${RUNR_RELEASE_COMMIT} \
    RUNR_RELEASE_BRANCH=${RUNR_RELEASE_BRANCH}

WORKDIR /app

COPY --from=node-runtime /usr/local/ /usr/local/

# Workers execute CV extraction, document conversion, rendered career-source
# fallbacks, and server-side PDF generation. These are intentionally explicit;
# removing them requires a separate route/dependency extraction ticket.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        fonts-dejavu-core \
        fonts-liberation \
        libreoffice-writer \
        tesseract-ocr \
        tesseract-ocr-deu \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-linux.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements-linux.txt

COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN npm --prefix frontend ci \
    && cd frontend \
    && npx playwright install --with-deps chromium \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/*

COPY backend ./backend
COPY frontend/scripts/render-cv-pdf.mjs ./frontend/scripts/render-cv-pdf.mjs
COPY frontend/src/lib/cvStudio.js ./frontend/src/lib/cvStudio.js
COPY frontend/src/lib/cvSocialLinks.js ./frontend/src/lib/cvSocialLinks.js
COPY scripts ./scripts
COPY workspace_runner.py ./workspace_runner.py
COPY deploy/start.sh ./deploy/start.sh

RUN chmod +x deploy/start.sh \
    && useradd --create-home --uid 10001 runr \
    && mkdir -p /app/.backend_data /ms-playwright \
    && chown -R runr:runr /app /ms-playwright

USER runr

CMD ["./deploy/start.sh", "worker"]
