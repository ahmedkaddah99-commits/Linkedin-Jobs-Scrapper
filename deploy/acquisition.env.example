# Copy to /opt/runr/.env.acquisition on the VPS and replace placeholders in the
# secret store. Do not add customer document, email, OAuth, billing, or Clerk
# credentials to this file.
RUNR_ENV=production
DATABASE_BACKEND=turso
TURSO_DATABASE_URL=replace-with-secret-store-reference
TURSO_AUTH_TOKEN=replace-with-secret-store-reference
RUNR_STORAGE_BACKEND=sqlite
RUNR_DATA_DIR=/var/lib/runr/acquisition-data
RUNR_ACQUISITION_MANIFEST=/srv/runr/shared/inputs/SOURCE_ELIGIBILITY_MANIFEST_RC005_RECONCILED.json
RUNR_ACQUISITION_STATE_ROOT=/srv/runr/state/active
# Point these at the preserved authoritative producer databases when they are
# stored under a release-specific checkpoint directory.
RUNR_LINKEDIN_STATE_DIR=/srv/runr/state/active/linkedin
RUNR_EMPLOYER_STATE_DIR=/srv/runr/state/active/employer
RUNR_LINKEDIN_STATE_DB=/srv/runr/state/active/linkedin/master_linkedin_jobs_state.db
RUNR_EMPLOYER_STATE_DB=/srv/runr/state/active/employer/master_employer_jobs_state.db
RUNR_ACQUISITION_EXPORT_ROOT=/srv/runr/exports
RUNR_ACQUISITION_RECEIPT_ROOT=/srv/runr/exports/receipts
RUNR_ACQUISITION_LOCK_ROOT=/srv/runr/state/locks
RUNR_LINKEDIN_PAGINATION_REPORT=/srv/runr/shared/inputs/linkedin_endpoint_pagination_validation.json
RUNR_LINKEDIN_FILTERS_REPORT=/srv/runr/shared/inputs/linkedin_guest_endpoint_filter_validation.json
RUNR_COMPANY_IDENTITY_CROSSWALK=/srv/runr/state/active/company_identity_crosswalk.json
RUNR_ACQUISITION_INCLUDE_SINGLE_SOURCE=1
RUNR_SOURCE_VERSION=replace-with-deployed-git-sha
OBJECT_STORAGE_BACKEND=r2
S3_ENDPOINT_URL=replace-with-secret-store-reference
S3_ACCESS_KEY_ID=replace-with-secret-store-reference
S3_SECRET_ACCESS_KEY=replace-with-secret-store-reference
S3_BUCKET=replace-with-acquisition-bucket-or-prefix
S3_REGION=auto

# Provider credentials are injected only when an authorized source run is
# enabled. Keep request budgets and kill switches explicit in the release.
SCRAPEOPS_API_KEY=replace-with-secret-store-reference
WEBSHARE_PROXY_URL=replace-with-secret-store-reference
WEBSHARE_PROXY_USERNAME=replace-with-secret-store-reference
WEBSHARE_PROXY_PASSWORD=replace-with-secret-store-reference
RUNR_ACQUISITION_LIVE_NETWORK_ENABLED=false
RUNR_ENABLE_LIVE_NETWORKING_DISCOVERY=false
# Fail closed until the current provider allowance is recorded. The two
# source caps must be positive and their sum must not exceed the total cap.
RUNR_ACQUISITION_MAX_REQUESTS=30
RUNR_LINKEDIN_MAX_REQUESTS=20
RUNR_EMPLOYER_MAX_REQUESTS=10
RUNR_LINKEDIN_WORKERS=10
RUNR_LINKEDIN_DETAIL_WORKERS=5
RUNR_LINKEDIN_PER_PROXY_CONCURRENCY=1
RUNR_EMPLOYER_COMPANY_CONCURRENCY=1
RUNR_EMPLOYER_HTTP_CONCURRENCY=4
RUNR_EMPLOYER_BROWSER_CONCURRENCY=1
RUNR_EMPLOYER_ACCOUNT_CONCURRENCY=1
RUNR_EMPLOYER_PER_ORIGIN_CONCURRENCY=1
RUNR_COMPANY_ENRICHMENT_ENABLED=0
