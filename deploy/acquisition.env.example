# Copy to /opt/runr/.env.acquisition on the VPS and replace placeholders in the
# secret store. Do not add customer document, email, OAuth, billing, or Clerk
# credentials to this file.
RUNR_ENV=production
DATABASE_BACKEND=turso
TURSO_DATABASE_URL=replace-with-secret-store-reference
TURSO_AUTH_TOKEN=replace-with-secret-store-reference
RUNR_STORAGE_BACKEND=sqlite
RUNR_DATA_DIR=/var/lib/runr/acquisition-data
RUNR_ACQUISITION_MANIFEST=/srv/runr/shared/inputs/SOURCE_ELIGIBILITY_MANIFEST_RC005_RECONCILED.json
RUNR_ACQUISITION_STATE_ROOT=/srv/runr/state
RUNR_ACQUISITION_EXPORT_ROOT=/srv/runr/exports
RUNR_ACQUISITION_INCLUDE_SINGLE_SOURCE=1
RUNR_SOURCE_VERSION=replace-with-deployed-git-sha
OBJECT_STORAGE_BACKEND=r2
S3_ENDPOINT_URL=replace-with-secret-store-reference
S3_ACCESS_KEY_ID=replace-with-secret-store-reference
S3_SECRET_ACCESS_KEY=replace-with-secret-store-reference
S3_BUCKET=replace-with-acquisition-bucket-or-prefix
S3_REGION=auto

# Provider credentials are injected only when an authorized source run is
# enabled. Keep request budgets and kill switches explicit in the release.
SCRAPEOPS_API_KEY=replace-with-secret-store-reference
WEBSHARE_PROXY_URL=replace-with-secret-store-reference
WEBSHARE_PROXY_USERNAME=replace-with-secret-store-reference
WEBSHARE_PROXY_PASSWORD=replace-with-secret-store-reference
RUNR_ACQUISITION_LIVE_NETWORK_ENABLED=false
RUNR_ENABLE_LIVE_NETWORKING_DISCOVERY=false
RUNR_ACQUISITION_MAX_REQUESTS=0
RUNR_LINKEDIN_MAX_REQUESTS=0
RUNR_EMPLOYER_MAX_REQUESTS=0
RUNR_COMPANY_ENRICHMENT_ENABLED=0
