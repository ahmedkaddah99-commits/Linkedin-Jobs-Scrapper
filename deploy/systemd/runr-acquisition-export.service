[Unit]
Description=Runr daily combined company/job export
After=runr-acquisition-cycle.service
Wants=runr-acquisition-cycle.service

[Service]
Type=oneshot
WorkingDirectory=/opt/runr
User=runr-acquisition
Group=runr-acquisition
UMask=0077
EnvironmentFile=/opt/runr/.env.acquisition
Environment=RUNR_PYTHON_BIN=/opt/runr/.venv/bin/python
Environment=RUNR_ACQUISITION_INPUT_ROOT=/srv/runr/shared/inputs
Environment=RUNR_ACQUISITION_STATE_ROOT=/srv/runr/state
Environment=RUNR_ACQUISITION_EXPORT_ROOT=/srv/runr/exports
Environment=RUNR_ACQUISITION_BACKUP_ROOT=/srv/runr/backups
Environment=RUNR_SKIP_PROJECT_DOTENV=1
ExecStart=/opt/runr/.venv/bin/python /opt/runr/scripts/build_master_jobs_catalog.py \
  --linkedin-csv /srv/runr/exports/linkedin/master_linkedin_jobs.csv \
  --employer-csv /srv/runr/exports/employer/master_employer_jobs.csv \
  --output /srv/runr/exports/combined/master_jobs.csv
CPUAccounting=true
CPUQuota=100%
MemoryAccounting=true
MemoryHigh=2G
MemoryMax=3G
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/runr/exports
