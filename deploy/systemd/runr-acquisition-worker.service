[Unit]
Description=Runr acquisition worker
After=network-online.target time-sync.target
Wants=network-online.target
PartOf=runr.target

[Service]
Type=simple
WorkingDirectory=/opt/runr
User=runr-acquisition
Group=runr-acquisition
UMask=0077
EnvironmentFile=/opt/runr/.env.acquisition
Environment=RUNR_PYTHON_BIN=/opt/runr/.venv/bin/python
Environment=RUNR_DATA_DIR=/var/lib/runr/acquisition-data
Environment=RUNR_ACQUISITION_INPUT_ROOT=/srv/runr/shared/inputs
Environment=RUNR_ACQUISITION_STATE_ROOT=/srv/runr/state
Environment=RUNR_ACQUISITION_EXPORT_ROOT=/srv/runr/exports
Environment=RUNR_ACQUISITION_BACKUP_ROOT=/srv/runr/backups
Environment=RUNR_WORKER_LOG_DIR=/var/log/runr/acquisition
Environment=WORKER_ROLE=acquisition
Environment=WORKER_ID=vps_acquisition_worker
Environment=RUNR_SKIP_PROJECT_DOTENV=1
Environment=PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
# Source collectors and their shared-state bridge run from the daily oneshot.
# Keep this long-lived worker available for leases/maintenance without letting
# it run the legacy source scheduler in parallel.
Environment=RUNR_ACQUISITION_SCHEDULER_DISABLED=true
ExecStart=/opt/runr/deploy/start.sh acquisition
Restart=always
RestartSec=5
TimeoutStopSec=300
CPUAccounting=true
CPUQuota=300%
MemoryAccounting=true
MemoryHigh=9G
MemoryMax=12G
TasksMax=512
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/runr /srv/runr/state /srv/runr/exports /srv/runr/backups /var/log/runr/acquisition

[Install]
WantedBy=multi-user.target
