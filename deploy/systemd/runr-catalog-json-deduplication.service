[Unit]
Description=Runr resumable exact catalog JSON deduplication
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/runr
UMask=0077
EnvironmentFile=/opt/runr/.env.acquisition
EnvironmentFile=/etc/runr/acquisition-catalog.env
EnvironmentFile=/etc/runr/catalog-storage.env
Environment=RUNR_SKIP_PROJECT_DOTENV=1
ExecStart=/usr/bin/flock -n -E 75 /srv/runr/state/locks/catalog-storage-backfill.lock /opt/runr/.venv/bin/python scripts/deduplicate_catalog_json.py --checkpoint /srv/runr/state/catalog-exact-deduplication/checkpoint.json --apply --keep-compaction-guards --batch-size 500 --max-seconds 1200
TimeoutStartSec=25min
TimeoutStopSec=60
KillSignal=SIGINT
SuccessExitStatus=75
CPUQuota=100%
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/runr/state /srv/runr/exports

[Install]
WantedBy=multi-user.target
