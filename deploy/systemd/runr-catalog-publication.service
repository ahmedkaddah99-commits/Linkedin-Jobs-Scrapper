[Unit]
Description=Runr durable catalog publication recovery
After=network-online.target

[Service]
Type=oneshot
User=runr-acquisition
Group=runr-acquisition
WorkingDirectory=/opt/runr
EnvironmentFile=/opt/runr/.env.acquisition
EnvironmentFile=/etc/runr/acquisition-catalog.env
Environment=RUNR_SKIP_PROJECT_DOTENV=1
ExecStart=/usr/bin/flock -n -E 75 /srv/runr/state/locks/publisher.lock /opt/runr/.venv/bin/python scripts/process_catalog_publication.py --max-seconds 120 --batch-size 200
SuccessExitStatus=75
TimeoutStartSec=240
MemoryMax=1G
CPUQuota=100%
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/runr/state /srv/runr/exports /var/lib/runr

