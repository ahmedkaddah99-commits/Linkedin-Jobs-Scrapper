[Unit]
Description=Runr bounded employer-site acquisition
After=network-online.target time-sync.target
Wants=network-online.target
PartOf=runr.target

[Service]
Type=oneshot
WorkingDirectory=/opt/runr
User=runr-acquisition
Group=runr-acquisition
UMask=0077
EnvironmentFile=/opt/runr/.env.acquisition
EnvironmentFile=-/opt/runr/.env.acquisition.provider
Environment=RUNR_PYTHON_BIN=/opt/runr/.venv/bin/python
Environment=RUNR_SKIP_PROJECT_DOTENV=1
Environment=PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ExecStart=/opt/runr/deploy/run-acquisition-source.sh employer
ExecStartPost=/usr/bin/systemctl start --no-block runr-acquisition-publisher.service
CPUAccounting=true
CPUQuota=250%
MemoryAccounting=true
MemoryHigh=6G
MemoryMax=9G
TasksMax=384
TimeoutStartSec=infinity
TimeoutStopSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/runr /srv/runr/state /srv/runr/exports /srv/runr/backups

[Install]
WantedBy=multi-user.target
