[Unit]
Description=Runr published job network discovery
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/runr
User=runr-acquisition
Group=runr-acquisition
SupplementaryGroups=runr-database
UMask=0077
Environment=LD_LIBRARY_PATH=/usr/local/lib/runr/sqlite-3.54.0
EnvironmentFile=/opt/runr/.env.acquisition
EnvironmentFile=-/opt/runr/.env.acquisition.provider
EnvironmentFile=/etc/runr/nemo-enrichment.env
EnvironmentFile=/etc/runr/customer-current.env
Environment=RUNR_SKIP_PROJECT_DOTENV=1
UnsetEnvironment=TURSO_DATABASE_URL TURSO_AUTH_TOKEN RUNR_MIGRATION_HEAD
ExecStart=/usr/bin/flock -n /srv/runr/state/network-discovery.lock /opt/runr/.venv/bin/python scripts/process_published_network_discovery.py --max-jobs 10 --daily-budget 1
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/runr/state /var/lib/runr/customer-candidate-db
