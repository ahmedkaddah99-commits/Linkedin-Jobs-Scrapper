[Unit]
Description=Refresh Runr source eligibility manifest from live canonical companies
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=runr-acquisition
Group=runr-acquisition
WorkingDirectory=/opt/runr
Environment=RUNR_PROJECT_DIR=/opt/runr
EnvironmentFile=/opt/runr/.env.acquisition
EnvironmentFile=/etc/runr/acquisition-catalog.env
ExecStart=/opt/runr-ops/refresh-acquisition-manifest.sh
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/runr/shared/inputs/manifest-generations
