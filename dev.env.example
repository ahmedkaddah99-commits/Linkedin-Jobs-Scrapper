# Copy to dev.env and replace placeholders. Never commit dev.env.
RUNR_ENV=development

# Use a dedicated Turso development database, never the production database.
DATABASE_BACKEND=turso
TURSO_DATABASE_URL=libsql://runr-dev-your-organization.turso.io
TURSO_AUTH_TOKEN=replace-with-a-development-token

# Local object storage is recommended while developing storage integrations.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_ROOT=.backend_storage/objects
OBJECT_STORAGE_CACHE_ROOT=.backend_storage/cache
LOCAL_OBJECT_STORAGE_BASE_URL=http://127.0.0.1:8000/v1/storage/objects
LOCAL_OBJECT_STORAGE_SIGNING_SECRET=replace-with-a-local-development-secret

# To test Cloudflare R2, set OBJECT_STORAGE_BACKEND=r2 and replace these values.
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=replace-with-a-development-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-development-secret-key
S3_BUCKET=runr-development
S3_REGION=auto
S3_SIGNED_URL_TTL_SECONDS=900

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
VITE_CLERK_PUBLISHABLE_KEY=

LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=

SCRAPEOPS_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
