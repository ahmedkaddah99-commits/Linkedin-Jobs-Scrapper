################################################################################
# Local development environment
################################################################################
# Copy this file to dev.env, then fill in the DEV values only.
#
# dev.env is for your local machine.
# Render production values belong in the Render dashboard, not in dev.env.

APP_ENV=development

################################################################################
# Turso / libSQL database
################################################################################
# ACTIVE LOCAL DEV DATABASE VALUES
# Use the output from:
#   turso db show --url runr-dev
#   turso db tokens create runr-dev

DATABASE_BACKEND=turso
TURSO_DATABASE_URL=<RUNR_DEV_TURSO_DATABASE_URL>
TURSO_AUTH_TOKEN=<RUNR_DEV_TURSO_DB_TOKEN>

# PRODUCTION DATABASE VALUES - REFERENCE ONLY
# Do not uncomment these in dev.env.
# Add these values later in the Render dashboard instead:
#
# Render env var: TURSO_DATABASE_URL=<RUNR_PROD_TURSO_DATABASE_URL>
# Render env var: TURSO_AUTH_TOKEN=<RUNR_PROD_TURSO_DB_TOKEN>

################################################################################
# Object storage
################################################################################
# Local development uses local object storage.
# Production should use R2/S3 and should be configured in Render.

OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_ROOT=.backend_storage/objects
OBJECT_STORAGE_CACHE_ROOT=.backend_storage/cache

# PRODUCTION OBJECT STORAGE - REFERENCE ONLY
# Do not uncomment these in dev.env.
# Add these values later in the Render dashboard instead:
#
# Render env var: OBJECT_STORAGE_BACKEND=r2
# Render env var: S3_ENDPOINT_URL=https://40226ea8efe7ec8500517aed3e35a4e3.r2.cloudflarestorage.com
# Render env var: S3_ACCESS_KEY_ID=<RUNR_PROD_R2_ACCESS_KEY_ID>
# Render env var: S3_SECRET_ACCESS_KEY=<RUNR_PROD_R2_SECRET_ACCESS_KEY>
# Render env var: S3_BUCKET=runr-prod-artifacts
# Render env var: S3_REGION=auto

# If you intentionally want to test R2 from your local machine, temporarily
# replace the local object storage block above with this block. Do not commit
# real key values.
#
# OBJECT_STORAGE_BACKEND=r2
# S3_ENDPOINT_URL=https://40226ea8efe7ec8500517aed3e35a4e3.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=<RUNR_PROD_R2_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<RUNR_PROD_R2_SECRET_ACCESS_KEY>
# S3_BUCKET=runr-prod-artifacts
# S3_REGION=auto

################################################################################
# Clerk authentication
################################################################################
# Use Clerk development/test keys locally. Production values belong in Render.

CLERK_SECRET_KEY=<CLERK_DEV_SECRET_KEY>
CLERK_PUBLISHABLE_KEY=<CLERK_DEV_PUBLISHABLE_KEY>
CLERK_WEBHOOK_SECRET=<CLERK_DEV_WEBHOOK_SECRET>
VITE_CLERK_PUBLISHABLE_KEY=<CLERK_DEV_PUBLISHABLE_KEY>

################################################################################
# Creem billing
################################################################################
# Start with Creem test mode. A key prefixed with creem_test_ uses the sandbox
# API automatically. Do not put live keys in dev.env.

CREEM_API_KEY=<CREEM_TEST_API_KEY>
CREEM_WEBHOOK_SECRET=<CREEM_TEST_WEBHOOK_SECRET>
CREEM_PRO_PRODUCT_ID=<CREEM_TEST_PRO_PRODUCT_ID>
CREEM_BUSINESS_PRODUCT_ID=<CREEM_TEST_BUSINESS_PRODUCT_ID>

################################################################################
# Workload providers
################################################################################

SCRAPEOPS_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
